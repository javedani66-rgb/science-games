  "empty_fill": "#2a0b60",
  "locked_fill": "#34145f",
  "dash": "#9a78e0",
  "disabled_day_fill": "#d9d3e8",
  "disabled_day_text": "#4a4268",
  "disabled_day_rim": "#6d6492",
  "easy": "#2fa44a",
  "mid": "#ff9d1c",
  "hard": "#ff4b4b",
  "gold_deep": "#b88300",
  "cyan_deep": "#0d9c87"
 },
 "fonts": {
  "display": {
   "family": "Lalezar",
   "weights": [
    400
   ],
   "roles": [
    "title",
    "button_label",
    "icon_label"
   ],
   "rule": "titles (sheet title too), text on buttons, icon labels and plates",
   "max_words": 4,
   "min_px": 20,
   "large_min_px": 24,
   "note": "Lalezar has one weight (400), so WCAG large text starts at 24px; on a fill whose ratio is below 4.5 the size must be >= 24px"
  },
  "base": {
   "family": "Vazirmatn",
   "weights": [
    400,
    700
   ],
   "roles": [
    "body",
    "long_text"
   ],
   "rule": "explanatory and long reading text: sheet body, descriptions, captions, sub-lines"
  }
 },
 "radius_scale": {
  "sm": 10,
  "md": 16,
  "lg": 18,
  "xl": 28,
  "full": "half of height (chip_simple 24, lock 18)"
 },
 "global_rules": {
  "clip_path": "forbidden",
  "sharp_corner": "forbidden: every corner of every control has the row radius (no 0, no asymmetric)",
  "opacity_on_text": "forbidden (use disabled colors)",
  "difficulty_on_node_sheet": "forbidden: the three difficulty levels appear only in challenge_row, challenge_stack (environment) and the mission bar in a scene",
  "text_on_map_without_plate": "forbidden (map_label plate or zone_title halo only)",
  "text_pattern": "light text (white) with a same-family shadow on a coloured fill that is darkened until white >= 3.3 (24px Lalezar). Light fills (cream/white) keep navy text, no shadow",
  "shadow_cannot_rescue": "a bright fill is never rescued by shadow: fill-floor (text/fill >= 3, or 4.5 below 24px) AND effective ratio with shadow >= 4.5 must both hold",
  "darken_fill_not_text": "if a ratio fails, darken the fill; never make the text paler",
  "base_picker": "the base choice is a row in the menu plus a sheet; no permanent chips on the map",
  "stars_rewards": "forbidden (B4)"
 },
 "state_rules": {
  "pressed": {
   "shift_px": 2,
   "lip_px_day": 2,
   "glow_blur_px_night": 10,
   "fill": "variant.pressed_fill",
   "text": "unchanged"
  },
  "disabled": {
   "day": {
    "fill": "#d9d3e8",
    "text": "#4a4268",
    "rim": "#6d6492",
    "rim_style": "dashed",
    "stripes": true
   },
   "night": {
    "fill": "#34145f",
    "text": "#cdb8ff",
    "rim": "#9a78e0",
    "rim_style": "dashed",
    "stripes": true
   },
   "shadow": "none",
   "note": "looks different from normal by dashed rim and stripes; text stays readable (>=4.5); a lock icon is added when locked"
  },
  "focus": {
   "ring_px": 4,
   "offset_px": 3,
   "on_light_surface": "#4b3b9e",
   "on_dark_surface": "#ffd23f",
   "note": "ring sits outside the control, separated by a 3px gap of surface"
  }
