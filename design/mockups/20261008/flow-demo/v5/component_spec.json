   "team/assets_r2/ui/ui_tokens.css"
  ],
  "wcag": {
   "text_min": 4.5,
   "large_text_min": 3,
   "large_px": 24,
   "large_bold_px": 18.66,
   "nontext_min": 3,
   "fill_floor_light_text": 3.0,
   "effective_min": 4.5,
   "ring_px": 1.5,
   "ring_percentile": 5
  },
  "touch_min_px": 48,
  "min_gap_px": 8,
  "min_font_px": 16,
  "derived_rule": "pressed_fill = mix(fill, edge, 0.12); edge = #120c3a (day) / #190539 (night). shadow = mix(fill, #190539, 0.7). deep fills: see derived_colors"
 },
