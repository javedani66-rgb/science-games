{
 "_doc": "قالب‌نامهٔ کنترل‌های v5 (ماشین‌خوان، نسخهٔ ۳: رنگ‌های جان‌دار v4 + نوشتهٔ روشن با حاشیهٔ ضخیم هم‌خانواده). منبع حقیقت برای spec_sample.html و tests/spec_contrast.py. ماکت؛ تصمیم مالک ۱۴ اکتبر (گزینهٔ ب).",
 "meta": {
  "version": "draft-3",
  "status": "proposal",
  "date": "2026-10-14",
  "palette_sources": [
   "team/assets_r2/light/zone_tokens.json",
   "team/assets_r2/ui/ui_tokens.css"
  ],
  "wcag": {
   "text_min": 4.5,
   "large_text_min": 3,
   "large_px": 24,
   "large_bold_px": 18.66,
   "nontext_min": 3,
   "effective_min": 4.5,
   "ring_px": 1.5,
   "ring_percentile": 5,
   "outline_required_below_raw": 4.5,
   "outline_vs_fill_min": 3
  },
  "touch_min_px": 48,
  "min_gap_px": 8,
  "min_font_px": 16,
  "derived_rule": "pressed_fill = mix(fill, edge, 0.12); edge = #120c3a (day) / #190539 (night). shadow = mix(fill, #190539, 0.7). deep fills: see derived_colors"
 },
 "palette": {
  "cream": "#fff3c4",
  "navy_line": "#241a5e",
  "night_bg": "#190539",
  "edge": "#120c3a",
  "chip_violet": "#4b3b9e",
  "violet_light": "#7a6af5",
  "purple_hold": "#8a4fe0",
  "lilac": "#a99dff",
  "lilac_pale": "#cdb8ff",
  "gold": "#ffd23f",
  "cyan": "#46f0d8",
  "pink": "#ff7be5",
  "white": "#ffffff",
  "card_plate": "#07203a",
  "empty_fill": "#2a0b60",
  "locked_fill": "#34145f",
  "dash": "#9a78e0",
  "disabled_day_fill": "#d9d3e8",
  "disabled_day_text": "#4a4268",
  "disabled_day_rim": "#6d6492",
  "easy": "#2fa44a",
  "mid": "#ff9d1c",
  "hard": "#ff4b4b",
  "easy_rim_night": "#a6f0b4",
  "mid_rim_night": "#ffd29a",
  "hard_rim_night": "#ffb0b0"
 },
 "fonts": {
  "display": {
   "family": "Lalezar",
   "weights": [
    400
   ],
   "roles": [
    "title",
    "button_label",
    "icon_label"
   ],
   "rule": "titles (sheet title too), text on buttons, icon labels and plates",
   "max_words": 4,
   "min_px": 20,
   "large_min_px": 24,
   "note": "Lalezar has one weight (400); outlined 24px+ on buttons/titles, 20px on plates and map labels"
  },
  "base": {
   "family": "Vazirmatn",
   "weights": [
    400,
    700
   ],
   "roles": [
    "body",
    "long_text"
   ],
   "rule": "explanatory and long reading text: sheet body, descriptions, captions, sub-lines"
  }
 },
 "radius_scale": {
  "sm": 10,
  "md": 16,
  "lg": 18,
  "xl": 28,
  "full": "half of height (chip_simple 24, lock 18)"
 },
 "global_rules": {
  "clip_path": "forbidden",
  "sharp_corner": "forbidden: every corner of every control has the row radius (no 0, no asymmetric)",
  "opacity_on_text": "forbidden (use disabled colors)",
  "difficulty_on_node_sheet": "forbidden: the three difficulty levels appear only in challenge_row, challenge_stack (environment) and the mission bar in a scene",
  "text_on_map_without_plate": "forbidden (map_label plate or zone_title halo only)",
  "text_pattern": "light text (white or cream) on a VIVID v4 fill = thick same-family dark outline (stroke 5px, 6px for titles) plus a 3px drop; colour = mix(fill, #190539, .82). Cream/white fills keep navy text, no outline.",
  "base_picker": "the base choice is a row in the menu plus a sheet; no permanent chips on the map",
  "stars_rewards": "forbidden (B4)",
  "vivid_fill_never_darkened": "owner decision 14 Oct (option b): the bright v4 fill is never darkened; if the ring ratio fails, make the outline thicker or darker, not the fill",
  "outline_effective": "effective ratio = pixel measure on the ring around the letters (p5 >= 4.5) AND outline vs fill >= 3",
  "map_text": "map labels are cream Lalezar with a 6px navy outline (same pattern as the zone title); status plates (اینجایی, اول: …, اختیاری) keep a plate"
 },
 "state_rules": {
  "pressed": {
   "shift_px": 2,
   "lip_px_day": 2,
   "glow_blur_px_night": 10,
   "fill": "variant.pressed_fill",
   "text": "unchanged"
  },
  "disabled": {
   "day": {
    "fill": "#d9d3e8",
    "text": "#4a4268",
    "rim": "#6d6492",
    "rim_style": "dashed",
    "stripes": true
   },
   "night": {
    "fill": "#34145f",
    "text": "#cdb8ff",
    "rim": "#9a78e0",
    "rim_style": "dashed",
    "stripes": true
   },
   "shadow": "none",
   "note": "looks different from normal by dashed rim and stripes; text stays readable (>=4.5); a lock icon is added when locked"
  },
  "focus": {
   "ring_px": 4,
   "offset_px": 3,
   "on_light_surface": "#4b3b9e",
   "on_dark_surface": "#ffd23f",
   "note": "ring sits outside the control, separated by a 3px gap of surface"
  }
 },
